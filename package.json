{
  "name": "christmas_tree_generator",
  "version": "1.0.0",
  "description": "ASCII Christmas Tree Generator with TypeScript and Playwright",
  "main": "src/dist/treeNext.js",
  "scripts": {
    "build": "tsc src/treeNext.ts --outDir src/dist",
    "build:all": "tsc src/treeSimple.ts --outDir src/dist && tsc src/treeNext.ts --outDir src/dist",

    "start": "npm run build && node src/dist/treeNext.js",
    "start:simple": "tsc src/treeSimple.ts --outDir src/dist && node src/dist/treeSimple.js",

    "generate": "npm run build && node src/dist/treeNext.js",

    "test": "npm run build && playwright test",
    "test:ui": "npm run build && playwright test --ui",
    "test:headed": "npm run build && playwright test --headed",
    "test:debug": "npm run build && playwright test --debug",
    "test:report": "playwright show-report",

    "clean": "rm -rf src/dist src/output test-output test-results playwright-report",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json"
  },
  "keywords": [
    "christmas",
    "tree",
    "ascii",
    "generator",
    "typescript",
    "playwright",
    "testing"
  ],
  "author": "Alex",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
